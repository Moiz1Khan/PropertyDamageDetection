[Unit]
Description=OffmarketStream FastAPI
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/offmarketstream/backend
EnvironmentFile=/var/www/offmarketstream/deploy/.env.production
ExecStart=/var/www/offmarketstream/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
